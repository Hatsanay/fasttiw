NEXT_PUBLIC_API_URL=http://localhost:3003/api/V1
SESSION_COOKIE_NAME=fasttiw_store_session
# ต้องตั้งเป็นโดเมนจริงตอน deploy ใช้งานจริง — ใช้คำนวณ metadataBase/sitemap/robots.txt (SEO)
# และเป็นฐานของ callback ของ Google login ด้วย ต้องตรงกับ STORE_URL ฝั่ง backend
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ต้องตรงกับ INTERNAL_PROXY_SECRET ฝั่ง backend (ดู backend/.env.example)
INTERNAL_PROXY_SECRET=

# เข้าสู่ระบบด้วย Google — client ID ตัวเดียวกับ GOOGLE_CLIENT_ID ฝั่ง backend (ค่าสาธารณะ ไม่ใช่ความลับ)
# ไม่ตั้ง = ไม่แสดงปุ่ม Google ทั้งหน้า login และหน้าสมัคร
GOOGLE_CLIENT_ID=
